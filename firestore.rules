rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function profileIsApproved() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (!('status' in profile()) || profile().status == 'approved');
    }

    function sameCompany(company) {
      return profileIsApproved() && profile().companyId == company;
    }

    function isAdmin(company) {
      return sameCompany(company) && profile().role == 'admin';
    }

    function bookingPath(bookingId) {
      return /databases/$(database)/documents/reservations/$(bookingId);
    }

    function roomPath(roomId) {
      return /databases/$(database)/documents/rooms/$(roomId);
    }

    function userUsagePath(company, userId, month) {
      return /databases/$(database)/documents/companies/$(company)/userMonthlyUsage/$(userId + '_' + month);
    }

    function userPackageLimit(company, userId) {
      let userProfile = get(/databases/$(database)/documents/users/$(userId)).data;
      let packagePath = /databases/$(database)/documents/companies/$(company)/packages/active;
      let packageLimit = exists(packagePath) ? get(packagePath).data.monthlyHours : null;
      return ('monthlyHours' in userProfile && userProfile.monthlyHours is number)
        ? userProfile.monthlyHours
        : (packageLimit is number ? packageLimit : 50);
    }

    function userUsageWithinPackage(company, booking) {
      let usagePath = userUsagePath(
        company,
        booking.userId,
        booking.date.substr(0, 7)
      );
      let hoursUsed = exists(usagePath) ? get(usagePath).data.hoursUsed : 0;
      return hoursUsed is number
        && hoursUsed >= 0
        && hoursUsed + booking.hours <= userPackageLimit(company, booking.userId);
    }

    function validReservation(company) {
      return request.resource.data.keys().hasOnly([
          'userId', 'userName', 'companyId', 'roomId', 'roomName',
          'date', 'blocks', 'slotKeys', 'hours', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'userId', 'userName', 'companyId', 'roomId', 'roomName',
          'date', 'blocks', 'slotKeys', 'hours', 'status', 'createdAt'
        ])
        && request.resource.data.companyId == company
        && request.resource.data.roomId is string
        && exists(roomPath(request.resource.data.roomId))
        && get(roomPath(request.resource.data.roomId)).data.companyId == company
        && get(roomPath(request.resource.data.roomId)).data.active == true
        && get(roomPath(request.resource.data.roomId)).data.name == request.resource.data.roomName
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userName == profile().name
        && request.resource.data.roomName is string
        && request.resource.data.status == 'confirmed'
        && request.resource.data.date is string
        && request.resource.data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.blocks is list
        && request.resource.data.blocks.size() > 0
        && request.resource.data.blocks.size() <= 20
        && request.resource.data.slotKeys is list
        && request.resource.data.slotKeys.size() == request.resource.data.blocks.size()
        && request.resource.data.hours == request.resource.data.blocks.size() * 0.5
        && request.resource.data.createdAt is number
        && userUsageWithinPackage(company, request.resource.data);
    }

    function usageMatchesBookingMonth(company, booking) {
      return request.resource.data.companyId == company
        && request.resource.data.month == booking.date.substr(0, 7)
        && request.resource.data.hoursUsed >= 0;
    }

    function validUserUsageSeed(company, usageId) {
      let userPath = /databases/$(database)/documents/users/$(request.resource.data.userId);
      return request.resource.data.keys().hasOnly(['companyId', 'userId', 'month', 'hoursUsed'])
        && request.resource.data.keys().hasAll(['companyId', 'userId', 'month', 'hoursUsed'])
        && request.resource.data.companyId == company
        && exists(userPath)
        && (!('status' in get(userPath).data) || get(userPath).data.status == 'approved')
        && request.resource.data.userId is string
        && request.resource.data.month is string
        && request.resource.data.month.matches('^\\d{4}-\\d{2}$')
        && request.resource.data.hoursUsed is number
        && request.resource.data.hoursUsed >= 0
        && usageId == request.resource.data.userId + '_' + request.resource.data.month;
    }

    function validUsageCreate(company) {
      let bookingId = request.resource.data.lastReservationId;
      let path = bookingPath(bookingId);
      let afterBooking = getAfter(path).data;
      return existsAfter(path)
        && !exists(path)
        && afterBooking.companyId == company
        && afterBooking.userId == request.auth.uid
        && afterBooking.status == 'confirmed'
        && usageMatchesBookingMonth(company, afterBooking)
        && request.resource.data.hoursUsed == afterBooking.hours;
    }

    function validUsageUpdate(company) {
      let bookingId = request.resource.data.lastReservationId;
      let path = bookingPath(bookingId);
      let afterBooking = getAfter(path).data;
      return existsAfter(path)
        && afterBooking.companyId == company
        && (
          afterBooking.userId == request.auth.uid
          || (afterBooking.status == 'cancelled' && isAdmin(company))
        )
        && usageMatchesBookingMonth(company, afterBooking)
        && (
          (
            !exists(path)
            && afterBooking.status == 'confirmed'
            && afterBooking.hours == request.resource.data.hoursUsed - resource.data.hoursUsed
          )
          || (
            exists(path)
            && get(path).data.status == 'confirmed'
            && afterBooking.status == 'cancelled'
            && afterBooking.hours == resource.data.hoursUsed - request.resource.data.hoursUsed
          )
        );
    }

    function userUsageMatchesBooking(company, booking) {
      return request.resource.data.companyId == company
        && request.resource.data.userId is string
        && request.resource.data.userId == booking.userId
        && request.resource.data.month is string
        && request.resource.data.month == booking.date.substr(0, 7)
        && request.resource.data.hoursUsed is number
        && request.resource.data.hoursUsed >= 0;
    }

    function validUserUsageCreate(company) {
      let bookingId = request.resource.data.lastReservationId;
      let path = bookingPath(bookingId);
      let afterBooking = getAfter(path).data;
      return existsAfter(path)
        && !exists(path)
        && afterBooking.companyId == company
        && afterBooking.userId == request.auth.uid
        && afterBooking.status == 'confirmed'
        && userUsageMatchesBooking(company, afterBooking)
        && request.resource.data.hoursUsed == afterBooking.hours
        && request.resource.data.hoursUsed <= userPackageLimit(company, afterBooking.userId);
    }

    function validUserUsageUpdate(company) {
      let bookingId = request.resource.data.lastReservationId;
      let path = bookingPath(bookingId);
      let afterBooking = getAfter(path).data;
      return existsAfter(path)
        && afterBooking.companyId == company
        && userUsageMatchesBooking(company, afterBooking)
        && (
          (
            !exists(path)
            && afterBooking.userId == request.auth.uid
            && afterBooking.status == 'confirmed'
            && request.resource.data.hoursUsed == resource.data.hoursUsed + afterBooking.hours
            && request.resource.data.hoursUsed <= userPackageLimit(company, afterBooking.userId)
          )
          || (
            exists(path)
            && get(path).data.status == 'confirmed'
            && afterBooking.status == 'cancelled'
            && (
              afterBooking.userId == request.auth.uid
              || isAdmin(company)
            )
            && request.resource.data.hoursUsed == resource.data.hoursUsed - afterBooking.hours
          )
        );
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.role == 'user'
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'role', 'companyId', 'status']);
      allow read: if signedIn()
        && (request.auth.uid == userId || isAdmin(resource.data.companyId));
      allow update: if (
        signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email'])
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'role', 'companyId', 'status', 'packageLabel', 'monthlyHours'])
      ) || (
        isAdmin(resource.data.companyId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'role', 'packageLabel', 'monthlyHours'])
        && (
          (
            resource.data.status == 'pending'
            && request.resource.data.status in ['approved', 'rejected']
            && request.resource.data.role in ['user', 'admin']
          )
          || (
            resource.data.status != 'pending'
            && request.resource.data.status == resource.data.status
            && request.resource.data.role == resource.data.role
          )
        )
        && (
          request.resource.data.status == 'rejected'
          || (
            request.resource.data.packageLabel is string
            && request.resource.data.packageLabel.size() > 0
            && request.resource.data.monthlyHours is number
            && request.resource.data.monthlyHours >= 0
          )
        )
      );
      allow delete: if isAdmin(resource.data.companyId);
    }

    match /rooms/{roomId} {
      allow read: if profileIsApproved();
      allow create: if isAdmin(request.resource.data.companyId)
        && request.resource.data.active is bool
        && request.resource.data.capacity is int
        && request.resource.data.capacity > 0
        && request.resource.data.openTime is string
        && request.resource.data.openTime.matches('^([01][0-9]|2[0-3]):(00|30)$')
        && request.resource.data.closeTime is string
        && request.resource.data.closeTime.matches('^([01][0-9]|2[0-3]):(00|30)$')
        && request.resource.data.openTime < request.resource.data.closeTime;
      allow update: if isAdmin(resource.data.companyId)
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.active is bool
        && request.resource.data.capacity is int
        && request.resource.data.capacity > 0
        && request.resource.data.openTime.matches('^([01][0-9]|2[0-3]):(00|30)$')
        && request.resource.data.closeTime.matches('^([01][0-9]|2[0-3]):(00|30)$')
        && request.resource.data.openTime < request.resource.data.closeTime;
      allow delete: if isAdmin(resource.data.companyId);
    }

    match /reservations/{reservationId} {
      allow read: if profileIsApproved();
      allow create: if profileIsApproved()
        && validReservation(request.resource.data.companyId);
      allow update: if profileIsApproved()
        && resource.data.status == 'confirmed'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && (
          isAdmin(resource.data.companyId)
          || resource.data.userId == request.auth.uid
        );
      allow delete: if isAdmin(resource.data.companyId);
    }

    match /roomSlots/{slotId} {
      allow get, list: if profileIsApproved();
      allow create: if profileIsApproved()
        && existsAfter(bookingPath(request.resource.data.reservationId))
        && getAfter(bookingPath(request.resource.data.reservationId)).data.companyId == request.resource.data.companyId
        && getAfter(bookingPath(request.resource.data.reservationId)).data.userId == request.auth.uid
        && getAfter(bookingPath(request.resource.data.reservationId)).data.status == 'confirmed'
        && getAfter(bookingPath(request.resource.data.reservationId)).data.roomId == request.resource.data.roomId
        && getAfter(bookingPath(request.resource.data.reservationId)).data.date == request.resource.data.date
        && getAfter(bookingPath(request.resource.data.reservationId)).data.blocks.hasAny([request.resource.data.time])
        && getAfter(bookingPath(request.resource.data.reservationId)).data.slotKeys.hasAny([slotId])
        && request.resource.data.time.matches('^([01][0-9]|2[0-3]):(00|30)$')
        && slotId == request.resource.data.roomId + '_' + request.resource.data.date + '_' + request.resource.data.time
        && exists(roomPath(request.resource.data.roomId))
        && get(roomPath(request.resource.data.roomId)).data.companyId == request.resource.data.companyId
        && get(roomPath(request.resource.data.roomId)).data.active == true
        && request.resource.data.time >= get(roomPath(request.resource.data.roomId)).data.openTime
        && request.resource.data.time < get(roomPath(request.resource.data.roomId)).data.closeTime;
      allow delete: if profileIsApproved()
        && existsAfter(bookingPath(resource.data.reservationId))
        && getAfter(bookingPath(resource.data.reservationId)).data.companyId == resource.data.companyId
        && getAfter(bookingPath(resource.data.reservationId)).data.roomId == resource.data.roomId
        && getAfter(bookingPath(resource.data.reservationId)).data.date == resource.data.date
        && getAfter(bookingPath(resource.data.reservationId)).data.blocks.hasAny([resource.data.time])
        && getAfter(bookingPath(resource.data.reservationId)).data.status == 'cancelled'
        && (
          getAfter(bookingPath(resource.data.reservationId)).data.userId == request.auth.uid
          || isAdmin(resource.data.companyId)
        );
      allow update: if false;
    }

    match /companies/{company}/packages/{packageId} {
      allow read: if profileIsApproved();
      allow write: if isAdmin(company);
    }

    match /companies/{company}/monthlyUsage/{month} {
      allow read: if sameCompany(company);
      allow create: if isAdmin(company) || (sameCompany(company) && validUsageCreate(company));
      allow update: if isAdmin(company) || (sameCompany(company) && validUsageUpdate(company));
      allow delete: if isAdmin(company);
    }

    match /companies/{company}/userMonthlyUsage/{usageId} {
      allow read: if profileIsApproved()
        && (
          isAdmin(company)
          || (
            resource.data.userId == request.auth.uid
            && usageId.matches('^' + request.auth.uid + '_\\d{4}-\\d{2}$')
          )
        );
      allow create: if (isAdmin(company) && validUserUsageSeed(company, usageId))
        || (
          profileIsApproved()
          && request.resource.data.keys().hasOnly([
            'companyId', 'userId', 'month', 'hoursUsed', 'lastReservationId'
          ])
          && request.resource.data.keys().hasAll(['companyId', 'userId', 'month', 'hoursUsed'])
          && request.resource.data.userId == request.auth.uid
          && usageId == request.resource.data.userId + '_' + request.resource.data.month
          && request.resource.data.month.matches('^\\d{4}-\\d{2}$')
          && validUserUsageCreate(company)
        );
      allow update: if profileIsApproved()
        && (isAdmin(company) || resource.data.userId == request.auth.uid)
        && usageId == request.resource.data.userId + '_' + request.resource.data.month
        && request.resource.data.month.matches('^\\d{4}-\\d{2}$')
        && request.resource.data.keys().hasOnly([
          'companyId', 'userId', 'month', 'hoursUsed', 'lastReservationId'
        ])
        && request.resource.data.keys().hasAll(['companyId', 'userId', 'month', 'hoursUsed', 'lastReservationId'])
        && validUserUsageUpdate(company);
      allow delete: if isAdmin(company);
    }
  }
}
