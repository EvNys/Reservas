rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function profileIsApproved() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (!('status' in profile()) || profile().status == 'approved');
    }

    function sameCompany(company) {
      return profileIsApproved() && profile().companyId == company;
    }

    function isAdmin(company) {
      return sameCompany(company) && profile().role == 'admin';
    }

    function bookingPath(bookingId) {
      return /databases/$(database)/documents/reservations/$(bookingId);
    }

    function validReservation(company) {
      return request.resource.data.keys().hasOnly([
          'userId', 'userName', 'companyId', 'roomId', 'roomName',
          'date', 'blocks', 'slotKeys', 'hours', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'userId', 'userName', 'companyId', 'roomId', 'roomName',
          'date', 'blocks', 'slotKeys', 'hours', 'status', 'createdAt'
        ])
        && request.resource.data.companyId == company
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userName == profile().name
        && request.resource.data.roomId is string
        && request.resource.data.roomName is string
        && request.resource.data.status == 'confirmed'
        && request.resource.data.date is string
        && request.resource.data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.blocks is list
        && request.resource.data.blocks.size() > 0
        && request.resource.data.blocks.size() <= 20
        && request.resource.data.slotKeys is list
        && request.resource.data.slotKeys.size() == request.resource.data.blocks.size()
        && request.resource.data.hours == request.resource.data.blocks.size() * 0.5
        && request.resource.data.createdAt is number;
    }

    function usageIsWithinLimit(company, booking) {
      return request.resource.data.companyId == company
        && request.resource.data.month == booking.date.substr(0, 7)
        && request.resource.data.hoursUsed >= 0
        && request.resource.data.hoursUsed <= get(
          /databases/$(database)/documents/companies/$(company)/packages/active
        ).data.monthlyHours;
    }

    function validUsageCreate(company) {
      let bookingId = request.resource.data.lastReservationId;
      let path = bookingPath(bookingId);
      let afterBooking = getAfter(path).data;
      return existsAfter(path)
        && !exists(path)
        && afterBooking.companyId == company
        && afterBooking.userId == request.auth.uid
        && afterBooking.status == 'confirmed'
        && usageIsWithinLimit(company, afterBooking)
        && request.resource.data.hoursUsed == afterBooking.hours;
    }

    function validUsageUpdate(company) {
      let bookingId = request.resource.data.lastReservationId;
      let path = bookingPath(bookingId);
      let afterBooking = getAfter(path).data;
      return existsAfter(path)
        && afterBooking.companyId == company
        && (
          afterBooking.userId == request.auth.uid
          || (afterBooking.status == 'cancelled' && isAdmin(company))
        )
        && usageIsWithinLimit(company, afterBooking)
        && (
          (
            !exists(path)
            && afterBooking.status == 'confirmed'
            && afterBooking.hours == request.resource.data.hoursUsed - resource.data.hoursUsed
          )
          || (
            exists(path)
            && get(path).data.status == 'confirmed'
            && afterBooking.status == 'cancelled'
            && afterBooking.hours == resource.data.hoursUsed - request.resource.data.hoursUsed
          )
        );
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.role == 'user'
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'role', 'companyId', 'status']);
      allow read: if signedIn()
        && (request.auth.uid == userId || isAdmin(resource.data.companyId));
      allow update: if (
        signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'role', 'companyId', 'status'])
      ) || (
        isAdmin(resource.data.companyId)
        && resource.data.status == 'pending'
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.role in ['user', 'admin']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'role'])
      );
      allow delete: if isAdmin(resource.data.companyId);
    }

    match /rooms/{roomId} {
      allow read: if sameCompany(resource.data.companyId);
      allow create: if isAdmin(request.resource.data.companyId)
        && request.resource.data.active is bool
        && request.resource.data.capacity is int
        && request.resource.data.capacity > 0
        && request.resource.data.openTime is string
        && request.resource.data.openTime.matches('^([01][0-9]|2[0-3]):(00|30)$')
        && request.resource.data.closeTime is string
        && request.resource.data.closeTime.matches('^([01][0-9]|2[0-3]):(00|30)$')
        && request.resource.data.openTime < request.resource.data.closeTime;
      allow update: if isAdmin(resource.data.companyId)
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.active is bool
        && request.resource.data.capacity is int
        && request.resource.data.capacity > 0
        && request.resource.data.openTime.matches('^([01][0-9]|2[0-3]):(00|30)$')
        && request.resource.data.closeTime.matches('^([01][0-9]|2[0-3]):(00|30)$')
        && request.resource.data.openTime < request.resource.data.closeTime;
      allow delete: if isAdmin(resource.data.companyId);
    }

    match /reservations/{reservationId} {
      allow read: if sameCompany(resource.data.companyId);
      allow create: if sameCompany(request.resource.data.companyId)
        && validReservation(request.resource.data.companyId);
      allow update: if sameCompany(resource.data.companyId)
        && (
          isAdmin(resource.data.companyId)
          || (
            resource.data.userId == request.auth.uid
            && resource.data.status == 'confirmed'
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          )
        );
      allow delete: if isAdmin(resource.data.companyId);
    }

    match /roomSlots/{slotId} {
      allow get: if signedIn()
        && (
          !exists(/databases/$(database)/documents/roomSlots/$(slotId))
          || sameCompany(resource.data.companyId)
        );
      allow list: if sameCompany(resource.data.companyId);
      allow create: if sameCompany(request.resource.data.companyId)
        && existsAfter(bookingPath(request.resource.data.reservationId))
        && getAfter(bookingPath(request.resource.data.reservationId)).data.companyId == request.resource.data.companyId
        && getAfter(bookingPath(request.resource.data.reservationId)).data.status == 'confirmed'
        && getAfter(bookingPath(request.resource.data.reservationId)).data.roomId == request.resource.data.roomId
        && getAfter(bookingPath(request.resource.data.reservationId)).data.date == request.resource.data.date
        && getAfter(bookingPath(request.resource.data.reservationId)).data.blocks.hasAny([request.resource.data.time])
        && getAfter(bookingPath(request.resource.data.reservationId)).data.slotKeys.hasAny([slotId])
        && request.resource.data.time.matches('^([01][0-9]|2[0-3]):(00|30)$')
        && slotId == request.resource.data.roomId + '_' + request.resource.data.date + '_' + request.resource.data.time
        && get(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.companyId == request.resource.data.companyId
        && get(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.active == true
        && request.resource.data.time >= get(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.openTime
        && request.resource.data.time < get(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.closeTime;
      allow delete: if isAdmin(resource.data.companyId)
        || (
          sameCompany(resource.data.companyId)
          && existsAfter(bookingPath(resource.data.reservationId))
          && getAfter(bookingPath(resource.data.reservationId)).data.status == 'cancelled'
        );
      allow update: if false;
    }

    match /companies/{company}/packages/{packageId} {
      allow read: if sameCompany(company);
      allow write: if isAdmin(company);
    }

    match /companies/{company}/monthlyUsage/{month} {
      allow read: if sameCompany(company);
      allow create: if isAdmin(company) || (sameCompany(company) && validUsageCreate(company));
      allow update: if isAdmin(company) || (sameCompany(company) && validUsageUpdate(company));
      allow delete: if isAdmin(company);
    }
  }
}
